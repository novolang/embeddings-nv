// embpool_tests.nv — pooling and normalisation: the mask-weighted mean,
// the last unmasked token, unit length, and Matryoshka truncation with
// its renormalisation.
//
// The numbers are arithmetic, worked by hand and written beside each
// assertion.  The pooling fixture is a three-token, two-dimensional
// matrix whose third row is padding, with values chosen so that the
// right answer and the two classic wrong answers are three different
// vectors:
//
//     token 0: [1, 0]    kept
//     token 1: [3, 4]    kept
//     token 2: [9, 9]    padding
//
// The mask-weighted mean is [2, 2].  Dividing by the row count instead
// of the mask sum gives [1.33, 1.33].  Forgetting the mask altogether
// gives [4.33, 4.33].
//
// `embvectors_tests.nv` compares the same functions with numpy over
// generated matrices.

use std.test
use ndfloat
use embpool
use embnorm
use embfault

// Three tokens in two dimensions; the third is padding.
fn tokens() -> NdFloat
    match ndfloat.of_list([1.0, 0.0, 3.0, 4.0, 9.0, 9.0], [3, 2])
        Ok(t)  => t
        Err(_) => ndfloat.scalar(0.0)

fn mask() -> [Int]
    [1, 1, 0]

@test
fn test_mean_pooling_divides_by_the_mask_and_not_by_the_row_count() [io]
    test.case("the mask-weighted mean of the two kept tokens")
    // ([1, 0] + [3, 4]) / 2 = [2, 2].  Dividing by 3 would give
    // [1.33, 1.33]; ignoring the mask would give [4.33, 4.33].
    match embpool.mean_pool(tokens(), mask())
        Err(f) => test.fail(f.message())
        Ok(v)  =>
            let xs = ndfloat.to_list(v)
            test.assert(list.len(xs) == 2)
            test.assert_approx(xs[0], 2.0, 0.000001)
            test.assert_approx(xs[1], 2.0, 0.000001)

    test.case("and the enum dispatches to the same arithmetic")
    match embpool.pool(EmbMeanPool, tokens(), mask())
        Err(f) => test.fail(f.message())
        Ok(v)  => test.assert_approx(ndfloat.to_list(v)[0], 2.0, 0.000001)

    test.case("with no padding the mean is over everything")
    // ([1, 0] + [3, 4] + [9, 9]) / 3 = [4.33, 4.33].
    match embpool.mean_pool(tokens(), embpool.no_mask(3))
        Err(f) => test.fail(f.message())
        Ok(v)  => test.assert_approx(ndfloat.to_list(v)[0], 4.333333, 0.0001)

    test.case("a mask that keeps nothing is a division by zero, caught")
    // The usual cause is an empty string tokenised and fed through
    // without a check; the usual symptom, uncaught, is a NaN that
    // travels all the way into a stored index.
    match embpool.mean_pool(tokens(), [0, 0, 0])
        Ok(v)  => test.fail("a mean over no tokens: ${ndfloat.to_list(v)}")
        Err(f) => test.assert(embfault.is_shape(f) == false)

    test.case("and a mask of the wrong length names both counts")
    match embpool.mean_pool(tokens(), [1, 1])
        Ok(v)  => test.fail("a mask of 2 over 3 tokens gave ${ndfloat.to_list(v)}")
        Err(f) => test.assert(embfault.is_shape(f))

@test
fn test_cls_is_the_first_row_and_last_is_the_last_kept_one() [io]
    test.case("CLS is position zero and does not consult the mask")
    match embpool.cls_pool(tokens())
        Err(f) => test.fail(f.message())
        Ok(v)  =>
            let xs = ndfloat.to_list(v)
            test.assert_approx(xs[0], 1.0, 0.000001)
            test.assert_approx(xs[1], 0.0, 0.000001)

    test.case("last is the last unmasked row, which is not the last row")
    // Row 2 is padding, so the answer is row 1: [3, 4].  Taking the
    // last row would give [9, 9] — a pad token's embedding — and the
    // two are different numbers on purpose.
    match embpool.last_pool(tokens(), mask())
        Err(f) => test.fail(f.message())
        Ok(v)  =>
            let xs = ndfloat.to_list(v)
            test.assert_approx(xs[0], 3.0, 0.000001)
            test.assert_approx(xs[1], 4.0, 0.000001)

    test.case("and the position it picked is available for a caller to check")
    test.assert(embpool.last_index(mask()) == 1)
    test.assert(embpool.last_index([0, 1, 1]) == 2)
    test.assert(embpool.last_index([0, 0, 0]) == -1)

    test.case("a right-padded mask is recognisable, and a left-padded one is not wrong")
    test.assert(embpool.is_right_padded([1, 1, 0]))
    test.assert(embpool.is_right_padded([0, 1, 1]) == false)
    test.assert(embpool.is_right_padded([1, 0, 1]) == false)

    test.case("max pooling excludes the masked rows rather than zeroing them")
    // Over rows 0 and 1 the coordinate-wise maximum is [3, 4].
    // Zeroing row 2 and taking the maximum over all three would give
    // the same answer here and the wrong one on a vector whose
    // maximum is negative, which the next case is.
    match embpool.max_pool(tokens(), mask())
        Err(f) => test.fail(f.message())
        Ok(v)  =>
            let xs = ndfloat.to_list(v)
            test.assert_approx(xs[0], 3.0, 0.000001)
            test.assert_approx(xs[1], 4.0, 0.000001)

    test.case("and a coordinate whose real maximum is negative stays negative")
    match ndfloat.of_list([-5.0, -1.0, 8.0, 8.0], [2, 2])
        Err(e) => test.fail(e.message())
        Ok(t)  =>
            match embpool.max_pool(t, [1, 0])
                Err(f) => test.fail(f.message())
                Ok(v)  => test.assert_approx(ndfloat.to_list(v)[0], -5.0, 0.000001)

@test
fn test_the_pooling_is_a_property_of_the_checkpoint_and_has_a_name() [io]
    test.case("the names are sentence-transformers' own spellings")
    test.assert(embpool.pooling_name(EmbMeanPool) == "mean")
    test.assert(embpool.pooling_name(EmbClsPool) == "cls")
    test.assert(embpool.pooling_name(EmbLastPool) == "last")
    test.assert(embpool.pooling_name(EmbMaxPool) == "max")

    test.case("and they parse back, so a config file maps across without a table")
    match embpool.pooling_of_name("cls")
        Some(k) => test.assert(embpool.pooling_name(k) == "cls")
        None    => test.fail("cls parsed as nothing")
    test.assert_none(embpool.pooling_of_name("average"))

    test.case("a mask says how much work a call actually did")
    test.assert(embpool.kept_count(mask()) == 2)
    test.assert(embpool.kept_count(embpool.no_mask(7)) == 7)
    test.assert(list.len(embpool.no_mask(7)) == 7)

@test
fn test_a_batch_pools_to_a_matrix_the_rest_of_the_package_takes() [io]
    test.case("a rank-3 batch pools to rank 2")
    // Two sequences of two tokens in two dimensions.  The first keeps
    // both tokens, the second keeps one.
    match ndfloat.of_list([1.0, 0.0, 3.0, 4.0, 5.0, 5.0, 9.0, 9.0], [2, 2, 2])
        Err(e) => test.fail(e.message())
        Ok(b)  =>
            match embpool.pool_batch(EmbMeanPool, b, [[1, 1], [1, 0]])
                Err(f) => test.fail(f.message())
                Ok(m)  =>
                    test.assert(ndfloat.rank(m) == 2)
                    test.assert(ndfloat.size(m) == 4)
                    let xs = ndfloat.to_list(m)
                    // Row 0: ([1,0] + [3,4]) / 2 = [2, 2].
                    test.assert_approx(xs[0], 2.0, 0.000001)
                    test.assert_approx(xs[1], 2.0, 0.000001)
                    // Row 1: [5, 5] alone.
                    test.assert_approx(xs[2], 5.0, 0.000001)

    test.case("and a rank-2 matrix is not a batch")
    match embpool.pool_batch(EmbMeanPool, tokens(), [[1, 1, 0]])
        Ok(m)  => test.fail("a rank-${ndfloat.rank(m)} batch out of a rank-2 input")
        Err(f) => test.assert(embfault.is_shape(f))

@test
fn test_normalising_is_what_makes_the_three_similarities_one() [io]
    test.case("a 3-4-5 vector normalises to 0.6 and 0.8")
    match ndfloat.of_list([3.0, 4.0], [2])
        Err(e) => test.fail(e.message())
        Ok(v)  =>
            match embnorm.norm(v)
                Ok(n)  => test.assert_approx(n, 5.0, 0.000001)
                Err(f) => test.fail(f.message())
            match embnorm.l2_normalize(v)
                Err(f) => test.fail(f.message())
                Ok(u)  =>
                    let xs = ndfloat.to_list(u)
                    test.assert_approx(xs[0], 0.6, 0.000001)
                    test.assert_approx(xs[1], 0.8, 0.000001)
                    test.assert(embnorm.is_normalized(u, 0.0001))
            test.assert(embnorm.is_normalized(v, 0.0001) == false)

    test.case("a zero vector has no direction and is given no number")
    match ndfloat.of_list([0.0, 0.0], [2])
        Err(e) => test.fail(e.message())
        Ok(z)  =>
            match embnorm.l2_normalize(z)
                Ok(u)  => test.fail("a zero vector normalised to ${ndfloat.to_list(u)}")
                Err(f) => test.assert(embfault.is_shape(f) == false)

    test.case("every row of a batch normalises, and the norms come back for a diagnostic")
    match ndfloat.of_list([3.0, 4.0, 0.0, 2.0], [2, 2])
        Err(e) => test.fail(e.message())
        Ok(m)  =>
            match embnorm.norm_of_rows(m)
                Err(f) => test.fail(f.message())
                Ok(ns) =>
                    test.assert(list.len(ns) == 2)
                    test.assert_approx(ns[0], 5.0, 0.000001)
                    test.assert_approx(ns[1], 2.0, 0.000001)
            match embnorm.normalize_rows(m)
                Ok(u)  => test.assert(embnorm.rows_normalized(u, 0.0001))
                Err(f) => test.fail(f.message())

@test
fn test_a_prefix_of_a_unit_vector_is_not_a_unit_vector() [io]
    // [0.6, 0.8, 0, 0] is already unit length, and its first two
    // coordinates carry all of its energy.  [0.6, 0, 0.8, 0] is also
    // unit length and its first two carry 0.36 of it — which is the
    // whole difference between a model trained for truncation and one
    // that was not.
    match ndfloat.of_list([0.6, 0.0, 0.8, 0.0], [4])
        Err(e) => test.fail(e.message())
        Ok(v)  =>
            test.case("truncating cuts and does not renormalise")
            match embnorm.truncate(v, 2)
                Err(f) => test.fail(f.message())
                Ok(t)  =>
                    test.assert(ndfloat.size(t) == 2)
                    // The norm of [0.6, 0] is 0.6, not 1.
                    match embnorm.norm(t)
                        Ok(n)  => test.assert_approx(n, 0.6, 0.000001)
                        Err(f) => test.fail(f.message())
                    test.assert(embnorm.is_normalized(t, 0.0001) == false)

            test.case("and the one to reach for does both")
            match embnorm.truncate_normalized(v, 2)
                Err(f) => test.fail(f.message())
                Ok(t)  =>
                    test.assert(embnorm.is_normalized(t, 0.0001))
                    test.assert_approx(ndfloat.to_list(t)[0], 1.0, 0.000001)

            test.case("the prefix energy is what says whether truncating is safe")
            // 0.36 of the energy in the first two of four, which is
            // barely more than the 0.5 a random vector would leave
            // there — a model that had been trained for truncation
            // would leave much more.
            match embnorm.energy_in_prefix(v, 2)
                Ok(e)  => test.assert_approx(e, 0.36, 0.0001)
                Err(f) => test.fail(f.message())
            match embnorm.energy_in_prefix(v, 4)
                Ok(e)  => test.assert_approx(e, 1.0, 0.000001)
                Err(f) => test.fail(f.message())

            test.case("a truncation to more than there is, or to none, is refused")
            match embnorm.truncate(v, 8)
                Ok(t)  => test.fail("a truncation to ${ndfloat.size(t)} out of four")
                Err(f) => test.assert(embfault.is_shape(f))
            match embnorm.truncate(v, 0)
                Ok(t)  => test.fail("a truncation to ${ndfloat.size(t)}")
                Err(f) => test.assert(embfault.is_shape(f))

    test.case("a batch truncates as a batch, and the corpus mean is the number to act on")
    match ndfloat.of_list([0.6, 0.0, 0.8, 0.0, 0.8, 0.0, 0.6, 0.0], [2, 4])
        Err(e) => test.fail(e.message())
        Ok(m)  =>
            match embnorm.truncate_rows(m, 2)
                Err(f) => test.fail(f.message())
                Ok(t)  =>
                    test.assert(ndfloat.size(t) == 4)
                    test.assert(embnorm.rows_normalized(t, 0.0001))
            // Row energies 0.36 and 0.64; the mean is 0.5.
            match embnorm.mean_energy_in_prefix(m, 2)
                Ok(e)  => test.assert_approx(e, 0.5, 0.0001)
                Err(f) => test.fail(f.message())
