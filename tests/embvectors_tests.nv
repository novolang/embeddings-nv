// embvectors_tests.nv — the package against numpy, over generated
// inputs.
//
// `tools/gen_vectors.py` writes the four tables below.  Each line is one
// case, its fields split by `|` and its lists by `,`.  numpy computes
// every expected number, following sentence-transformers where it
// defines the operation: its `Pooling` module for the four poolings, its
// `SimilarityFunction` for the three scores, and its
// `quantize_embeddings` for the binary sign bit.  The int8 codes follow
// the corpus-wide rule `embquant` states.

use std.test
use std.list
use std.str
use std.math
use ndfloat
use embpool
use embnorm
use embsim
use embquant

fn floats(field: Str) -> [Float]
    if str.len(field) == 0
        return []
    str.split(field, ",") |> list.map(x => float_of_string(x))

fn ints(field: Str) -> [Int]
    if str.len(field) == 0
        return []
    str.split(field, ",") |> list.map(x => int_of_string(x))

fn array(data: [Float], dims: [Int]) -> NdFloat
    match ndfloat.of_list(data, dims)
        Ok(a)  => a
        Err(_) => ndfloat.scalar(0.0)

fn close(a: [Float], b: [Float]) -> Bool
    if list.len(a) != list.len(b)
        return false
    for i in 0..list.len(a)
        if math.abs(a[i] - b[i]) > 0.000000001
            return false
    true

fn near(a: Float, b: Float) -> Bool
    math.abs(a - b) <= 0.000000001

fn pooled(kind: EmbPooling, tokens: NdFloat, mask: [Int]) -> [Float]
    match embpool.pool(kind, tokens, mask)
        Ok(v)  => ndfloat.to_list(v)
        Err(_) => []

