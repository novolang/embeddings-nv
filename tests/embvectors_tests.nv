@test
fn test_the_four_poolings_agree_with_sentence_transformers() [io]
    var wrong = 0
    for line in pool_vectors()
        let f = str.split(line, "|")
        let dims = ints(f[0])
        let tokens = array(floats(f[1]), dims)
        let mask = ints(f[2])
        if not close(pooled(EmbMeanPool, tokens, mask), floats(f[3]))
            wrong = wrong + 1
        if not close(pooled(EmbClsPool, tokens, mask), floats(f[4]))
            wrong = wrong + 1
        if not close(pooled(EmbLastPool, tokens, mask), floats(f[5]))
            wrong = wrong + 1
        if not close(pooled(EmbMaxPool, tokens, mask), floats(f[6]))
            wrong = wrong + 1
        match embpool.mean_pool(tokens, mask)
            Err(_) =>
                wrong = wrong + 1
            Ok(v)  =>
                match embnorm.l2_normalize(v)
                    Ok(u)  =>
                        if not close(ndfloat.to_list(u), floats(f[7]))
                            wrong = wrong + 1
                    Err(_) =>
                        wrong = wrong + 1

    test.case("forty generated sequences, every pooling and the normalised mean")
    test.assert(list.len(pool_vectors()) == 40)
    test.assert(wrong == 0)

@test
fn test_the_three_similarities_and_the_prefix_energy_agree_with_numpy() [io]
    var wrong = 0
    for line in sim_vectors()
        let f = str.split(line, "|")
        let a = floats(f[0])
        let b = floats(f[1])
        let va = array(a, [list.len(a)])
        let vb = array(b, [list.len(b)])
        match embsim.cosine(va, vb)
            Ok(s)  =>
                if not near(s, float_of_string(f[2]))
                    wrong = wrong + 1
            Err(_) =>
                wrong = wrong + 1
        match embsim.dot(va, vb)
            Ok(s)  =>
                if not near(s, float_of_string(f[3]))
                    wrong = wrong + 1
            Err(_) =>
                wrong = wrong + 1
        match embsim.score(EmbEuclidean, va, vb)
            Ok(s)  =>
                if not near(s, 0.0 - float_of_string(f[4]))
                    wrong = wrong + 1
            Err(_) =>
                wrong = wrong + 1
        match embnorm.energy_in_prefix(va, int_of_string(f[5]))
            Ok(e)  =>
                if not near(e, float_of_string(f[6]))
                    wrong = wrong + 1
            Err(_) =>
                wrong = wrong + 1

    test.case("forty generated pairs")
    test.assert(list.len(sim_vectors()) == 40)
    test.assert(wrong == 0)

@test
fn test_int8_codes_and_sign_bits_agree_with_numpy() [io]
    var wrong = 0
    for line in quant_vectors()
        let f = str.split(line, "|")
        let dims = ints(f[0])
        let corpus = array(floats(f[1]), dims)
        match embquant.calibrate(corpus)
            Err(_)       =>
                wrong = wrong + 1
            Ok((lo, hi)) =>
                if not near(lo, float_of_string(f[2])) or not near(hi, float_of_string(f[3]))
                    wrong = wrong + 1
                match embquant.to_int8_rows(corpus, lo, hi)
                    Err(_) =>
                        wrong = wrong + 1
                    Ok(qs) =>
                        let first = qs[0]
                        let second = qs[1]
                        if first.codes != ints(f[4]) or embquant.int8_zero(first) != int_of_string(f[5])
                            wrong = wrong + 1
                        match embquant.int8_dot(first, second)
                            Ok(d)  =>
                                if math.abs(d - float_of_string(f[6])) > 0.000001
                                    wrong = wrong + 1
                            Err(_) =>
                                wrong = wrong + 1
        match embquant.to_binary_rows(corpus)
            Err(_) =>
                wrong = wrong + 1
            Ok(bs) =>
                let first = bs[0]
                let second = bs[1]
                if first.words != ints(f[7]) or second.words != ints(f[8])
                    wrong = wrong + 1
                match embquant.hamming(first, second)
                    Ok(h)  =>
                        if h != int_of_string(f[9])
                            wrong = wrong + 1
                    Err(_) =>
                        wrong = wrong + 1

    test.case("thirty generated corpora, up to three words of bits each")
    test.assert(list.len(quant_vectors()) == 30)
    test.assert(wrong == 0)

@test
fn test_search_ranks_as_a_stable_sort_does() [io]
    var wrong = 0
    for line in rank_vectors()
        let f = str.split(line, "|")
        let metric = embsim.metric_of_name(f[0]) ?? EmbCosine
        let dims = ints(f[1])
        let corpus = array(floats(f[2]), dims)
        let q = floats(f[3])
        match embsim.score_many(metric, array(q, [list.len(q)]), corpus)
            Ok(ss) =>
                if not close(ss, floats(f[5]))
                    wrong = wrong + 1
            Err(_) =>
                wrong = wrong + 1
        match embsim.search(metric, array(q, [list.len(q)]), corpus, int_of_string(f[4]))
            Ok(hits) =>
                if embsim.hit_indices(hits) != ints(f[6])
                    wrong = wrong + 1
            Err(_)   =>
                wrong = wrong + 1

    test.case("ninety rankings, three metrics over thirty corpora")
    test.assert(list.len(rank_vectors()) == 90)
    test.assert(wrong == 0)
