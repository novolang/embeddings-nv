// embnorm.nv — unit length, and Matryoshka truncation.
//
// L2 normalisation scales a vector to length 1.  On unit vectors the dot
// product is the cosine similarity and the Euclidean distance is
// `sqrt(2 - 2 * cos)`, so a ranking over normalised vectors is the same
// under all three similarities.
//
// Nothing in this package normalises on the caller's behalf.  A
// function that did would hand back a vector the caller never stored,
// and a pipeline that keeps magnitude on purpose would lose it.
// `is_normalized` is what the package offers instead.
//
// A Matryoshka Representation Learning model (Kusupati et al., 2022) is
// trained so that every prefix of its output is itself a usable
// embedding.  A prefix of a unit vector is not a unit vector: its length
// is the square root of the fraction of the energy that fell in the
// prefix.  Truncating and comparing by cosine is safe, because cosine
// divides the length out, and truncating and comparing by dot product is
// not.  `truncate_normalized` truncates and renormalises.  Truncation
// only works on a model trained for it, and this package cannot tell
// whether it was.  `mean_energy_in_prefix` over the caller's own corpus
// is the measurement that decides.
//
// Every function that reads coordinates refuses one that is not a
// finite number with `EmbNotFinite` at its position, counted row-major
// over a matrix.

use std.list
use std.math
use embfault
use embrows
use ndfloat

// The vector scaled to unit length.
//
// `EmbZeroVector` for a vector whose norm is zero, since there is no
// direction to keep, and `EmbNotFinite` at the first coordinate that is
// not a number.
//
// ```novo
// use embnorm
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([3.0, 4.0], [2])
//         Err(e) => println(e.message())
//         Ok(v)  =>
//             match embnorm.l2_normalize(v)
//                 Ok(u)  => println("${ndfloat.to_list(u)}")
//                           // : [0.6, 0.8]
//                 Err(f) => println(f.message())
// ```
pub fn l2_normalize(v: NdFloat) -> Result<NdFloat, EmbFault>
    let xs = embrows.vector_of("vector", v)!
    embrows.finite(xs)!
    Ok(embrows.vector(embrows.unit(xs)!))

// Every row of a matrix scaled to unit length.
//
// `m` is rank 2, `[rows, dim]`: what `embpool.pool_batch` produces and
// what `embsim.score_many` takes, so a batch goes through the whole
// pipeline without being taken apart.
//
// A row whose norm is zero is `EmbZeroVector`, and the fault does not
// say which row.  `norm_of_rows` is the call that finds every one.
pub fn normalize_rows(m: NdFloat) -> Result<NdFloat, EmbFault>
    let rows = embrows.rows_of("matrix", m)!
    embrows.finite(ndfloat.to_list(m))!
    var flat: [Float] = []
    for r in rows
        list.append(flat, embrows.unit(r)!)
    Ok(embrows.made(flat, embrows.dims_of(m)))

// The Euclidean length of a vector.
pub fn norm(v: NdFloat) -> Result<Float, EmbFault>
    let xs = embrows.vector_of("vector", v)!
    embrows.finite(xs)!
    Ok(embrows.norm_of(xs))

// The Euclidean length of every row.
//
// For finding the zero rows in a batch, and for the diagnostic that
// catches a broken model before a store does: a corpus whose norms are
// all within a per cent of each other came from a normalised model,
// and one whose norms span two orders of magnitude did not.
pub fn norm_of_rows(m: NdFloat) -> Result<[Float], EmbFault>
    let rows = embrows.rows_of("matrix", m)!
    embrows.finite(ndfloat.to_list(m))!
    Ok(rows |> list.map(r => embrows.norm_of(r)))

// Whether a vector is already unit length, to within `eps`.
//
// What this package says instead of normalising for the caller.  A
// sensible `eps` is 0.0001: a normalised f32 pipeline lands within
// about 0.000001 and a merely small vector does not.
//
// False for an array that is not rank 1 and for one with a coordinate
// that is not finite.
pub fn is_normalized(v: NdFloat, eps: Float) -> Bool
    match norm(v)
        Ok(n)  => math.abs(n - 1.0) <= eps
        Err(_) => false

// Whether every row is unit length, to within `eps`.  False for an
// array that is not rank 2 and for one with a coordinate that is not
// finite.
pub fn rows_normalized(m: NdFloat, eps: Float) -> Bool
    match norm_of_rows(m)
        Ok(ns) => list.all(ns, n => math.abs(n - 1.0) <= eps)
        Err(_) => false

// The first `dim` coordinates of a vector.
//
// Matryoshka truncation, and nothing else: it does not renormalise.
// `EmbBadTruncation` for a `dim` below 1 or above the vector's length.
//
// On a model trained for it this is a coarse embedding.  On a model
// that was not, it is `dim` arbitrary coordinates.  This package cannot
// tell the two apart.
pub fn truncate(v: NdFloat, dim: Int) -> Result<NdFloat, EmbFault>
    let xs = embrows.vector_of("vector", v)!
    Ok(embrows.vector(prefix(xs, dim)!))

// The first `dim` coordinates, renormalised to unit length.
//
// The one to reach for.  A prefix of a unit vector is not a unit vector,
// so truncating and then comparing by dot product favours whichever
// vectors kept more energy early.  `EmbZeroVector` when the prefix is
// all zeros.
//
// ```novo
// use embnorm
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([0.6, 0.8, 0.0, 0.0], [4])
//         Err(e) => println(e.message())
//         Ok(v)  =>
//             match embnorm.truncate_normalized(v, 2)
//                 Ok(t)  => println("${ndfloat.to_list(t)}")
//                 Err(f) => println(f.message())
// ```
pub fn truncate_normalized(v: NdFloat, dim: Int) -> Result<NdFloat, EmbFault>
    l2_normalize(truncate(v, dim)!)

// Every row truncated to `dim` and renormalised.
pub fn truncate_rows(m: NdFloat, dim: Int) -> Result<NdFloat, EmbFault>
    let rows = embrows.rows_of("matrix", m)!
    var flat: [Float] = []
    for r in rows
        list.append(flat, prefix(r, dim)!)
    normalize_rows(embrows.made(flat, [list.len(rows), dim]))

// How much of a vector's energy falls in its first `dim` coordinates:
// `norm(prefix)^2 / norm(whole)^2`, in [0, 1].
//
// The number that says whether a truncation is safe, measured on the
// caller's own data.  A trained Matryoshka model at half its dimensions
// keeps most of the energy.  A model that was not trained this way keeps
// about `dim / full`, which is what a prefix of an arbitrary vector
// keeps by chance.
//
// `EmbBadTruncation` for a `dim` below 1 or above the length, and
// `EmbZeroVector` for a vector with no energy at all.
pub fn energy_in_prefix(v: NdFloat, dim: Int) -> Result<Float, EmbFault>
    let xs = embrows.vector_of("vector", v)!
    embrows.finite(xs)!
    energy_of(xs, dim)

// The mean of `energy_in_prefix` over every row.
//
// The corpus-level form, which is the one to act on: a single vector's
// prefix energy varies, and the average over a few thousand is the
// number that decides a storage format.
//
// A matrix with no rows has no energy to measure and is `EmbZeroVector`,
// as a zero row is.
pub fn mean_energy_in_prefix(m: NdFloat, dim: Int) -> Result<Float, EmbFault>
    let rows = embrows.rows_of("matrix", m)!
    embrows.finite(ndfloat.to_list(m))!
    if list.len(rows) == 0
        return Err(EmbZeroVector)
    var total = 0.0
    for r in rows
        total = total + energy_of(r, dim)!
    Ok(total / list.len(rows) as Float)

// The first `dim` coordinates of `xs`, or `EmbBadTruncation`.
fn prefix(xs: [Float], dim: Int) -> Result<[Float], EmbFault>
    if dim < 1 or dim > list.len(xs)
        return Err(EmbBadTruncation(dim, list.len(xs)))
    Ok(xs[0:dim])

fn energy_of(xs: [Float], dim: Int) -> Result<Float, EmbFault>
    let head = prefix(xs, dim)!
    let whole = embrows.dot_of(xs, xs)
    if whole == 0.0
        return Err(EmbZeroVector)
    Ok(embrows.dot_of(head, head) / whole)
