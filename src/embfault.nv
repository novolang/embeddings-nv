// embfault.nv — what the arithmetic could not do, and the shapes that
// made it impossible.
//
// The package has a fault type of its own rather than answering
// ndarray-nv's `NdFault`, for two reasons.  A mismatch here has a
// meaning ndarray-nv cannot know: a mask of 512 entries over a matrix of
// 384 tokens is a tokenizer and a model disagreeing, which is the
// commonest mistake in an embedding pipeline, and the fault says so.
// And a fault type is part of a signature, so answering `NdFault` would
// make ndarray-nv's error enum part of this package's interface.
// `of_array` is the one place the two meet.

use std.list

// What a call could not do.
//
// ```novo
// use embfault
//
// fn main() [io]
//     let f = EmbMaskMismatch(512, 384)
//     println(f.message())
// ```
pub enum EmbFault
    // The attention mask and the token matrix disagree about how many
    // tokens there are.  The commonest fault in an embedding pipeline:
    // a tokenizer padded to one length and a model returned another,
    // or a mask was built for the batch and handed to one sequence.
    EmbMaskMismatch(mask: Int, tokens: Int)
    // Two vectors of different lengths.  Usually one model's output
    // compared with another's: 768 against 384 is `all-mpnet` against
    // `all-MiniLM`.
    EmbDimMismatch(want: Int, got: Int)
    // An array whose rank or extents are not what the call needs.
    // `what` names the argument and `want` says the rank it wanted, so
    // "tokens wants rank 2, got 3" reads without the page.
    EmbShapeWrong(what: Str, want: Int, got: Int)
    // A pooling over a mask that selects nothing.  Mean pooling divides
    // by the number of unmasked tokens, and dividing by zero would put a
    // NaN into a stored index.  The usual cause is an empty string
    // tokenised and fed through without a check.
    EmbEmptyMask
    // A vector of all zeros where a direction was needed: cosine
    // similarity, L2 normalisation, binary quantisation.  It is given no
    // number, since 0.0 would make it dissimilar to everything and 1.0
    // similar, and both would show up as bad retrieval rather than as
    // an error.
    EmbZeroVector
    // A value that is not finite, at this coordinate.  One NaN in a
    // corpus of embeddings poisons every comparison it takes part in
    // and sorts unpredictably in a top-k.
    EmbNotFinite(at: Int)
    // A Matryoshka truncation to a length the vector does not have, or
    // to one below 1.  `want` and `got` are the two lengths.
    EmbBadTruncation(want: Int, got: Int)
    // A `k` that is not a number of results: below 1, or above the
    // number of rows there are to rank.
    EmbBadK(k: Int, rows: Int)
    // A quantisation range that is not a range: `lo` at or above `hi`,
    // or either not finite.  A corpus whose calibration collapsed to a
    // point is a corpus of identical vectors, and quantising it would
    // divide by zero.
    EmbBadRange(lo: Float, hi: Float)
    // Two quantised vectors that cannot be compared because they were
    // quantised against different calibrations.  A code means a
    // different amount under each, so a dot product between them is a
    // number with no meaning.
    EmbScaleMismatch
    // Two binary vectors of different lengths, in bits.
    EmbBitsMismatch(want: Int, got: Int)

// Every `EmbFault` is printed the same way: it names what was compared,
// and prints both sides.
impl Error for EmbFault
    fn message(self) -> Str
        match self
            EmbMaskMismatch(mask, tokens)  => "a mask of ${mask} over ${tokens} token(s)"
            EmbDimMismatch(want, got)      => "a vector of ${got} against one of ${want}"
            EmbShapeWrong(what, want, got) => "${what} wants rank ${want}, got ${got}"
            EmbEmptyMask                   => "a mask that selects no token at all"
            EmbZeroVector                  => "a zero vector has no direction"
            EmbNotFinite(at)               => "coordinate ${at} is not a finite number"
            EmbBadTruncation(want, got)    => "a truncation to ${want} of a vector of ${got}"
            EmbBadK(k, rows)               => "${k} result(s) out of ${rows} row(s)"
            EmbBadRange(lo, hi)            => "a calibration range of ${lo} to ${hi}"
            EmbScaleMismatch               => "two vectors quantised against different calibrations"
            EmbBitsMismatch(want, got)     => "${got} bit(s) against ${want}"

// Whether the fault is a shape the caller can fix by looking at its
// pipeline, rather than a value it must clean.
//
// False for `EmbZeroVector`, `EmbNotFinite` and `EmbEmptyMask`, which
// are rows a batch should count and skip rather than faults a program
// should stop on, and true for every other.  The split at the top of an
// ingestion loop.
//
// ```novo
// use embfault
//
// fn main() [io]
//     println("${embfault.is_shape(EmbZeroVector)}")
//     // : false
// ```
pub fn is_shape(f: EmbFault) -> Bool
    match f
        EmbZeroVector   => false
        EmbNotFinite(_) => false
        EmbEmptyMask    => false
        _               => true

// The `EmbFault` that stands for an ndarray-nv error, for a caller that
// runs its own array operations beside this package's and reports both
// in one type.
//
// `what` is the argument's name in this package's vocabulary, such as
// "tokens", "query" or "corpus".  A rank fault keeps both ranks, and a
// shape, size or broadcast fault becomes `EmbDimMismatch` over the two
// element counts.  A reduction over nothing becomes `EmbEmptyMask`,
// since in this package that is a pooling over no tokens.  An axis or an
// index out of range becomes `EmbShapeWrong` over the rank that was
// needed and the rank there is.  A bad range from `arange` or
// `linspace` becomes `EmbBadRange` with both ends 0.
//
// ```novo
// use embfault
//
// fn main() [io]
//     println(embfault.of_array("tokens", NdRankMismatch(2, 3)).message())
//     // : tokens wants rank 2, got 3
// ```
pub fn of_array(what: Str, e: NdFault) -> EmbFault
    match e
        NdRankMismatch(want, got)    => EmbShapeWrong(what, want, got)
        NdNotMatrix(_, rank)         => EmbShapeWrong(what, 2, rank)
        NdSizeMismatch(want, got)    => EmbDimMismatch(want, got)
        NdShapeMismatch(want, got)   => EmbDimMismatch(product(want), product(got))
        NdNotBroadcastable(l, r)     => EmbDimMismatch(product(l), product(r))
        NdEmptyReduction(_)          => EmbEmptyMask
        NdAxisOutOfRange(axis, rank) => EmbShapeWrong(what, axis + 1, rank)
        NdIndexOutOfRange(i, dims)   => EmbShapeWrong(what, list.len(i), list.len(dims))
        NdBadRange(_)                => EmbBadRange(0.0, 0.0)

fn product(dims: [Int]) -> Int
    list.fold(dims, (acc, d) => acc * d, 1)
