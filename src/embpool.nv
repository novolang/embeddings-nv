// embpool.nv — a token-embedding matrix down to one vector.
//
// Every body here is a `todo()`; the signatures are the design.
//
// WHAT THE INPUT IS.  A transformer that has read a sequence hands back
// one vector per TOKEN: a rank-2 `NdFloat` of `[tokens, dim]`, the
// model's last hidden state.  A store wants one vector per DOCUMENT.
// Pooling is the step between, and which pooling is not a preference —
// it is a property of the checkpoint, decided when it was trained, and
// written on its model card.  Using the wrong one produces embeddings
// that are the right shape, cluster plausibly, and retrieve badly.
//
// THE MASK IS NOT OPTIONAL AND THIS IS WHERE EVERYONE IS WRONG.  A
// batch is padded to its longest sequence, and the padding tokens have
// embeddings — the model computed something for them, and it is not
// zero.  A mean over all the rows therefore averages in a variable
// amount of noise that depends on what ELSE was in the batch, so the
// same document embeds differently depending on its neighbours.
//
// Two specific errors follow, and both have their own function here so
// that neither can be written by accident:
//
//   - MEAN POOLING DIVIDES BY THE MASK SUM, not by the row count.
//     Multiplying by the mask and dividing by `tokens` is the bug that
//     looks right: it zeroes the padding and then divides by a number
//     that includes it, so every embedding is scaled down by however
//     much padding it happened to get.  On a normalised output the
//     scaling cancels, which is why this survives review — until
//     somebody uses dot-product similarity and it does not.
//
//   - LAST-TOKEN POOLING TAKES THE LAST UNMASKED ROW, not the last
//     row.  On a right-padded batch those are different, and taking
//     the last row gives the embedding of a pad token.  On a
//     left-padded one they are the same, which is why this bug appears
//     when a pipeline moves from a decoder tokenizer to an encoder's.
//
// `no_mask` is here for the caller that genuinely has one sequence and
// no padding, so that "I have no mask" is something written on purpose
// rather than a `[]` that means something else.

// Which pooling a checkpoint was trained for.
//
// Not a preference.  `sentence-transformers/all-MiniLM-L6-v2` is mean,
// `BAAI/bge-*` is CLS, `intfloat/e5-mistral-7b-instruct` is last
// token, and using the wrong one on any of them gives vectors that
// look fine and retrieve badly.
//
// ```novo
// use embpool
//
// fn main() [io]
//     println(embpool.pooling_name(EmbMeanPool))
//     // : mean
// ```
pub enum EmbPooling
    // The mask-weighted average of the token vectors.  What most
    // sentence-transformers checkpoints were trained with, and the
    // default when a model card says nothing.
    EmbMeanPool
    // The first token's vector.  BERT-family models trained with a
    // `[CLS]` token at position 0, and the whole `bge` family.  The
    // mask is not consulted: position 0 is never padding.
    EmbClsPool
    // The last unmasked token's vector.  Decoder-only embedding models,
    // where the final position is the only one that has seen the whole
    // sequence.
    EmbLastPool
    // The coordinate-wise maximum over the unmasked tokens.  Rare in
    // current checkpoints and here because it is three lines and its
    // absence would send somebody to write it worse — the masked
    // positions must be excluded rather than set to zero, since a
    // coordinate whose true maximum is negative would come back as 0.
    EmbMaxPool

// The pooling's name, lower case: "mean", "cls", "last", "max".
//
// The spellings a sentence-transformers config uses, so a caller
// reading `1_Pooling/config.json` can map it across without a table.
pub fn pooling_name(k: EmbPooling) -> Str
    todo("embeddings-nv.embpool.pooling_name")

// The pooling a name spells.
pub fn pooling_of_name(name: Str) -> ?EmbPooling
    todo("embeddings-nv.embpool.pooling_of_name")

// One sequence pooled to one vector.
//
// `tokens` is rank 2, `[tokens, dim]`.  `mask` is one entry per token:
// non-zero keeps it, zero is padding.  The result is rank 1, `[dim]`.
//
// `EmbMaskMismatch` when the two disagree about the token count,
// `EmbShapeWrong` for a `tokens` that is not rank 2, and `EmbEmptyMask`
// when nothing is kept.
//
// ```novo
// use embpool
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 2.0, 3.0, 4.0], [2, 2])
//         Err(e) => println(e.message())
//         Ok(t)  =>
//             match embpool.pool(EmbMeanPool, t, [1, 1])
//                 Ok(v)  => println("${ndfloat.to_list(v)}")
//                 Err(f) => println(f.message())
// ```
pub fn pool(kind: EmbPooling, tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    todo("embeddings-nv.embpool.pool")

// The mask-weighted average of the token vectors.
//
// `sum(tokens[i] * mask[i]) / sum(mask)`, and the denominator is the
// thing to look at: it is the number of UNMASKED tokens, never the
// number of rows.  See the module comment for what the other division
// does and why it survives review.
pub fn mean_pool(tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    todo("embeddings-nv.embpool.mean_pool")

// The first token's vector.
//
// No mask: position 0 is never padding in any tokenizer that pads, and
// a caller that has left-padded a sequence to the point where it is
// has a different problem.
pub fn cls_pool(tokens: NdFloat) -> Result<NdFloat, EmbFault>
    todo("embeddings-nv.embpool.cls_pool")

// The last UNMASKED token's vector.
//
// Not the last row.  On a right-padded batch those differ and the last
// row is a pad token's embedding; on a left-padded one they agree,
// which is why this bug appears exactly when a pipeline moves between
// tokenizers.  `last_index` is the position this picked, for a caller
// that wants to see it.
pub fn last_pool(tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    todo("embeddings-nv.embpool.last_pool")

// The coordinate-wise maximum over the unmasked tokens.
//
// Masked positions are EXCLUDED rather than set to zero: a coordinate
// whose true maximum over the real tokens is negative would otherwise
// come back as 0, which is a value no token had.
pub fn max_pool(tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    todo("embeddings-nv.embpool.max_pool")

// A batch pooled to one vector each.
//
// `tokens` is rank 3, `[batch, tokens, dim]`, and `masks` has one mask
// per sequence.  The result is rank 2, `[batch, dim]` — which is
// exactly what `embsim.score_many` and `embnorm.normalize_rows` take,
// so a batch never has to be taken apart and put back together.
//
// `EmbShapeWrong` for a `tokens` that is not rank 3, and
// `EmbMaskMismatch` naming the first sequence whose mask does not fit.
pub fn pool_batch(kind: EmbPooling, tokens: NdFloat, masks: [[Int]]) -> Result<NdFloat, EmbFault>
    todo("embeddings-nv.embpool.pool_batch")

// A mask that keeps every token, for `count` of them.
//
// For the caller that genuinely has one sequence and no padding.  It
// exists so that "there is no padding here" is written on purpose,
// rather than passed as an empty list that would mean something else
// entirely.
pub fn no_mask(count: Int) -> [Int]
    todo("embeddings-nv.embpool.no_mask")

// How many tokens a mask keeps.
//
// The denominator of `mean_pool`, and the number a caller wants in its
// logs: an average of two kept tokens over a batch padded to 512 is a
// pipeline that is doing almost no work per call.
pub fn kept_count(mask: [Int]) -> Int
    todo("embeddings-nv.embpool.kept_count")

// The position of the last kept token, or -1 when the mask keeps none.
//
// What `last_pool` selects, exposed so a caller can check it against
// what it thinks its padding side is.  A right-padded sequence answers
// somewhere in the middle; a left-padded one answers the final index.
pub fn last_index(mask: [Int]) -> Int
    todo("embeddings-nv.embpool.last_index")

// Whether a mask has all its kept tokens at the START, which is what
// right padding looks like.
//
// A mask with kept tokens on both sides of a gap is a mask somebody
// built wrong, and this is the cheap check for it.  `false` for a
// left-padded mask, which is not wrong — the pair
// `is_right_padded` and `last_index` is how a caller tells the two
// conventions apart before it chooses a pooling.
pub fn is_right_padded(mask: [Int]) -> Bool
    todo("embeddings-nv.embpool.is_right_padded")
