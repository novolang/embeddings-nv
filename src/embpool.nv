// embpool.nv — a token-embedding matrix down to one vector.
//
// A transformer that has read a sequence hands back one vector per
// token: a rank-2 `NdFloat` of `[tokens, dim]`, the model's last hidden
// state.  A store wants one vector per document, and pooling is the step
// between.  Which pooling is right is a property of the checkpoint,
// fixed when it was trained and written on its model card.
//
// A batch is padded to its longest sequence, and the padding tokens have
// embeddings that are not zero.  The attention mask says which rows are
// real, and every pooling that reads more than one row reads the mask.
// The arithmetic is sentence-transformers' `Pooling` module:
//
//     mean   the sum of the kept rows over the number of kept rows
//     cls    row 0, with no mask
//     last   the last kept row
//     max    the coordinate-wise maximum over the kept rows
//
// A mask entry that is not zero keeps its row.  The mean divides by the
// number of kept rows, never by the number of rows, and the last kept
// row is not the last row of a right-padded sequence.  Each has its own
// function so that neither mistake can be written by accident.

use std.list
use embfault
use embrows
use ndfloat

// Which pooling a checkpoint was trained for.
//
// Not a preference.  `sentence-transformers/all-MiniLM-L6-v2` is mean,
// `BAAI/bge-*` is CLS, `intfloat/e5-mistral-7b-instruct` is last
// token, and using the wrong one on any of them gives vectors that
// look fine and retrieve badly.
//
// ```novo
// use embpool
//
// fn main() [io]
//     println(embpool.pooling_name(EmbMeanPool))
//     // : mean
// ```
pub enum EmbPooling
    // The mask-weighted average of the token vectors.  What most
    // sentence-transformers checkpoints were trained with, and the
    // default when a model card says nothing.
    EmbMeanPool
    // The first token's vector.  BERT-family models trained with a
    // `[CLS]` token at position 0, and the whole `bge` family.  The
    // mask is not consulted: position 0 is never padding.
    EmbClsPool
    // The last unmasked token's vector.  Decoder-only embedding models,
    // where the final position is the only one that has seen the whole
    // sequence.
    EmbLastPool
    // The coordinate-wise maximum over the unmasked tokens.  Rare in
    // current checkpoints.  The masked positions are excluded rather
    // than set to zero, since a coordinate whose true maximum is
    // negative would otherwise come back as 0.
    EmbMaxPool

// The pooling's name, lower case: "mean", "cls", "last", "max".
//
// The spellings a sentence-transformers config uses, so a caller
// reading `1_Pooling/config.json` can map it across without a table.
pub fn pooling_name(k: EmbPooling) -> Str
    match k
        EmbMeanPool => "mean"
        EmbClsPool  => "cls"
        EmbLastPool => "last"
        EmbMaxPool  => "max"

// The pooling a name spells, or `None` for a name that is not one of the
// four.  sentence-transformers' `lasttoken` is taken as `last`.
pub fn pooling_of_name(name: Str) -> ?EmbPooling
    match name
        "mean"      => Some(EmbMeanPool)
        "cls"       => Some(EmbClsPool)
        "last"      => Some(EmbLastPool)
        "lasttoken" => Some(EmbLastPool)
        "max"       => Some(EmbMaxPool)
        _           => None

// One sequence pooled to one vector.
//
// `tokens` is rank 2, `[tokens, dim]`.  `mask` is one entry per token:
// non-zero keeps it, zero is padding.  The result is rank 1, `[dim]`.
//
// `EmbMaskMismatch` when the two disagree about the token count,
// `EmbShapeWrong` for a `tokens` that is not rank 2, and `EmbEmptyMask`
// when nothing is kept.  `EmbClsPool` reads neither the mask nor its
// length.
//
// ```novo
// use embpool
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 2.0, 3.0, 4.0], [2, 2])
//         Err(e) => println(e.message())
//         Ok(t)  =>
//             match embpool.pool(EmbMeanPool, t, [1, 1])
//                 Ok(v)  => println("${ndfloat.to_list(v)}")
//                 Err(f) => println(f.message())
// ```
pub fn pool(kind: EmbPooling, tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    match kind
        EmbMeanPool => mean_pool(tokens, mask)
        EmbClsPool  => cls_pool(tokens)
        EmbLastPool => last_pool(tokens, mask)
        EmbMaxPool  => max_pool(tokens, mask)

// The mask-weighted average of the token vectors.
//
// The sum of the kept rows divided by the number of kept rows.  Dividing
// by the number of rows instead would scale every embedding down by the
// amount of padding it happened to get.
pub fn mean_pool(tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    let rows = kept_rows(tokens, mask)!
    let dim = embrows.cols_of(tokens)
    var sum = list.range(0, dim) |> list.map(_ => 0.0)
    for r in rows
        for c in 0..dim
            sum[c] = sum[c] + r[c]
    let n = list.len(rows) as Float
    Ok(embrows.vector(sum |> list.map(x => x / n)))

// The first token's vector.
//
// No mask: position 0 is the `[CLS]` token in every tokenizer that puts
// one there.  `EmbEmptyMask` for a matrix with no rows.
pub fn cls_pool(tokens: NdFloat) -> Result<NdFloat, EmbFault>
    let rows = embrows.rows_of("tokens", tokens)!
    if list.len(rows) == 0
        return Err(EmbEmptyMask)
    Ok(embrows.vector(rows[0][:]))

// The last unmasked token's vector.
//
// Not the last row.  On a right-padded batch the last row is a pad
// token's embedding, and on a left-padded one the two agree.
// `last_index` is the position this picks, for a caller that wants to
// see it.
pub fn last_pool(tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    let rows = kept_rows(tokens, mask)!
    Ok(embrows.vector(rows[list.len(rows) - 1][:]))

// The coordinate-wise maximum over the unmasked tokens.
//
// Masked positions are excluded rather than set to zero: a coordinate
// whose true maximum over the real tokens is negative would otherwise
// come back as 0, which is a value no token had.
pub fn max_pool(tokens: NdFloat, mask: [Int]) -> Result<NdFloat, EmbFault>
    let rows = kept_rows(tokens, mask)!
    var top = rows[0][:]
    for r in rows
        for c in 0..list.len(top)
            if r[c] > top[c]
                top[c] = r[c]
    Ok(embrows.vector(top))

// A batch pooled to one vector each.
//
// `tokens` is rank 3, `[batch, tokens, dim]`, and `masks` has one mask
// per sequence.  The result is rank 2, `[batch, dim]`, which is what
// `embsim.score_many` and `embnorm.normalize_rows` take.
//
// `EmbShapeWrong` for a `tokens` that is not rank 3.  `EmbMaskMismatch`
// with the number of masks and the batch size when the two differ, and
// with the mask's length and the token count for the first sequence
// whose mask does not fit.  A fault from one sequence is the fault of
// the whole call.
pub fn pool_batch(kind: EmbPooling, tokens: NdFloat, masks: [[Int]]) -> Result<NdFloat, EmbFault>
    if ndfloat.rank(tokens) != 3
        return Err(EmbShapeWrong("tokens", 3, ndfloat.rank(tokens)))
    let d = embrows.dims_of(tokens)
    if list.len(masks) != d[0]
        return Err(EmbMaskMismatch(list.len(masks), d[0]))
    let flat = ndfloat.to_list(tokens)
    let step = d[1] * d[2]
    var pooled: [[Float]] = []
    for b in 0..d[0]
        let one = embrows.made(flat[b * step:b * step + step], [d[1], d[2]])
        let v = pool(kind, one, masks[b])!
        list.push(pooled, ndfloat.to_list(v))
    Ok(embrows.matrix(pooled, d[2]))

// A mask that keeps every token, for `count` of them.
//
// For the caller that genuinely has one sequence and no padding.  It
// exists so that "there is no padding here" is written on purpose,
// rather than passed as an empty list that would mean something else
// entirely.
pub fn no_mask(count: Int) -> [Int]
    list.range(0, count) |> list.map(_ => 1)

// How many tokens a mask keeps.
//
// The denominator of `mean_pool`, and the number a caller wants in its
// logs: an average of two kept tokens over a batch padded to 512 is a
// pipeline that is doing almost no work per call.
pub fn kept_count(mask: [Int]) -> Int
    list.count(mask, m => m != 0)

// The position of the last kept token, or -1 when the mask keeps none.
//
// What `last_pool` selects, exposed so a caller can check it against
// what it thinks its padding side is.  A right-padded sequence answers
// somewhere in the middle; a left-padded one answers the final index.
pub fn last_index(mask: [Int]) -> Int
    var last = 0 - 1
    for i in 0..list.len(mask)
        if mask[i] != 0
            last = i
    last

// Whether a mask has all its kept tokens at the start, which is what
// right padding looks like.  A mask that keeps every token, or none, is
// right-padded with no padding.
//
// False for a mask with kept tokens on both sides of a gap, which was
// built wrong, and for a left-padded mask, which is not wrong.
// `is_right_padded` and `last_index` together tell the two conventions
// apart.
pub fn is_right_padded(mask: [Int]) -> Bool
    last_index(mask) < kept_count(mask)

// The rows of `tokens` the mask keeps, after the checks every masked
// pooling makes: rank 2, one mask entry per row, and at least one kept.
fn kept_rows(tokens: NdFloat, mask: [Int]) -> Result<[[Float]], EmbFault>
    let rows = embrows.rows_of("tokens", tokens)!
    if list.len(mask) != list.len(rows)
        return Err(EmbMaskMismatch(list.len(mask), list.len(rows)))
    var kept: [[Float]] = []
    for i in 0..list.len(rows)
        if mask[i] != 0
            list.push(kept, rows[i][:])
    if list.len(kept) == 0
        return Err(EmbEmptyMask)
    Ok(kept)
