// embsim.nv — how close two embeddings are, and which of many is
// closest.
//
// Everything here is a similarity, and higher is closer.  hnsw-nv's
// convention is the opposite: an index compares distances and keeps the
// smallest, and a ranking sorts similarities and keeps the largest.
// Mixing the two returns the least relevant documents and raises
// nothing, so each package states its rule once.  `as_distance` is the
// one line between them.
//
// Euclidean distance is fitted to the rule the way sentence-transformers
// fits it: `EmbEuclidean`'s score is the negated distance, so that
// `top_k` is one function.  `euclidean_distance` is the positive number,
// for reporting.
//
// On unit vectors the three agree on the order.  The dot product is the
// cosine, and the Euclidean distance is `sqrt(2 - 2 * cos)`, which falls
// as the cosine rises.  On unnormalised vectors they disagree, and which
// is right is a property of how the model was trained.
//
// Every function refuses two vectors of different lengths with
// `EmbDimMismatch`, a coordinate that is not a finite number with
// `EmbNotFinite` at its position, and a zero vector under cosine with
// `EmbZeroVector`.  A corpus is a rank-2 array of `[rows, dim]` and a
// query is rank 1.

use std.list
use std.math
use embrows

// One ranked result: which row, and how similar.
//
// `index` is a position in whatever was ranked: the row index in the
// corpus matrix, not an identifier this package invented.  A caller
// joining back to its own records keeps its identifiers in the same
// order as its rows.
//
// ```novo
// use embsim
//
// fn main() [io]
//     let h = EmbHit { index: 3, score: 0.87 }
//     println("row ${h.index} at ${h.score}")
// ```
pub struct EmbHit
    // The row's position in the matrix that was ranked.
    index: Int
    // How similar, under the metric that was asked for.  Higher is
    // closer, always.
    score: Float

// Which similarity to rank by.
//
// ```novo
// use embsim
//
// fn main() [io]
//     println(embsim.metric_name(EmbCosine))
//     // : cosine
// ```
pub enum EmbMetric
    // `dot(a, b) / (|a| * |b|)`, in [-1, 1].  The default, and what a
    // model card means when it says "use cosine similarity".
    EmbCosine
    // `dot(a, b)`, unbounded.  The same ranking as cosine on unit
    // vectors and cheaper; on unnormalised ones it rewards magnitude,
    // which some rerankers train for on purpose.
    EmbDot
    // The negated Euclidean distance, so that higher is still closer,
    // as sentence-transformers defines it.  `euclidean_distance` is the
    // positive number.
    EmbEuclidean

// The metric's name, lower case: "cosine", "dot", "euclidean".
//
// The three spellings sentence-transformers' `SimilarityFunction`
// uses, so a caller porting a configuration does not have to translate.
pub fn metric_name(m: EmbMetric) -> Str
    match m
        EmbCosine    => "cosine"
        EmbDot       => "dot"
        EmbEuclidean => "euclidean"

// The metric a name spells.
pub fn metric_of_name(name: Str) -> ?EmbMetric
    match name
        "cosine"    => Some(EmbCosine)
        "dot"       => Some(EmbDot)
        "euclidean" => Some(EmbEuclidean)
        _           => None

// How similar two vectors are, under this metric.
//
// `EmbDimMismatch` when the lengths differ, `EmbZeroVector` for a zero
// vector under cosine, and `EmbNotFinite` at the first coordinate that
// is not a number.
//
// ```novo
// use embsim
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 0.0], [2])
//         Err(e) => println(e.message())
//         Ok(a)  =>
//             match embsim.score(EmbDot, a, a)
//                 Ok(s)  => println("${s}")
//                           // : 1
//                 Err(f) => println(f.message())
// ```
pub fn score(m: EmbMetric, left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    let a = embrows.vector_of("left", left)!
    let b = embrows.vector_of("right", right)!
    check_pair(a, b)!
    score_lists(m, a, b)

// Cosine similarity, in [-1, 1].
//
// 1 is identical in direction, 0 is orthogonal, -1 is opposite.
// `EmbZeroVector` on either side, because the denominator is zero and
// every substitute answer is wrong in a way that hides itself.
pub fn cosine(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    score(EmbCosine, left, right)

// The dot product.
pub fn dot(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    score(EmbDot, left, right)

// Euclidean distance: `sqrt(sum((a - b)^2))`.
//
// The positive number, for reporting.  `EmbEuclidean`'s score is this
// negated, so that higher is closer everywhere in this module.
pub fn euclidean_distance(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    Ok(math.sqrt(euclidean_squared(left, right)!))

// Squared Euclidean distance.
//
// Monotonic in the distance, so it ranks identically and skips a
// square root per comparison.  What `score_many` computes for
// `EmbEuclidean` before it negates and, for a caller writing its own
// loop, the one to write.
pub fn euclidean_squared(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    let a = embrows.vector_of("left", left)!
    let b = embrows.vector_of("right", right)!
    check_pair(a, b)!
    Ok(squared(a, b))

// One query against every row of a corpus.
//
// `corpus` is rank 2, `[rows, dim]`: what `embpool.pool_batch` and
// `embnorm.normalize_rows` produce.  `query` is rank 1, `[dim]`.  The
// result has one score per row, in row order.
//
// `EmbDimMismatch` when the query's length is not the corpus's width.
pub fn score_many(m: EmbMetric, query: NdFloat, corpus: NdFloat) -> Result<[Float], EmbFault>
    let q = embrows.vector_of("query", query)!
    let rows = embrows.rows_of("corpus", corpus)!
    check_width(q, corpus)!
    embrows.finite(q)!
    embrows.finite(ndfloat.to_list(corpus))!
    var out: [Float] = []
    for r in rows
        list.push(out, score_lists(m, q, r)!)
    Ok(out)

// Every query against every row: a `[queries, rows]` matrix of scores.
//
// The batch form, and the one whose cost a caller should think about
// before reaching for it: a thousand queries against a million rows is
// a billion scores and eight gigabytes of result.  `search` is what to
// use past the point where the scores themselves stop fitting, and
// hnsw-nv is what to use past the point where the corpus does.
pub fn pairwise(m: EmbMetric, queries: NdFloat, corpus: NdFloat) -> Result<NdFloat, EmbFault>
    let qs = embrows.rows_of("queries", queries)!
    embrows.rows_of("corpus", corpus)!
    if embrows.cols_of(queries) != embrows.cols_of(corpus)
        return Err(EmbDimMismatch(embrows.cols_of(queries), embrows.cols_of(corpus)))
    var flat: [Float] = []
    for q in qs
        list.append(flat, score_many(m, embrows.vector(q), corpus)!)
    Ok(embrows.made(flat, [list.len(qs), embrows.dims_of(corpus)[0]]))

// The `k` highest scores, with their positions, highest first.
//
// `EmbBadK` for a `k` below 1 or above the number of scores, and
// `EmbNotFinite` at a score that is not a finite number, since it would
// sort unpredictably.  Ties keep their row order, so a corpus with
// duplicate rows ranks them the way it stored them.
pub fn top_k(scores: [Float], k: Int) -> Result<[EmbHit], EmbFault>
    if k < 1 or k > list.len(scores)
        return Err(EmbBadK(k, list.len(scores)))
    embrows.finite(scores)!
    var keyed: [(Float, Int)] = []
    for i in 0..list.len(scores)
        list.push(keyed, (0.0 - scores[i], i))
    list.sort(keyed)
    Ok(keyed[0:k] |> list.map(e => EmbHit { index: e.1, score: scores[e.1] }))

// The `k` rows of a corpus most similar to a query.
//
// `score_many` and `top_k` in one call, which is what a caller doing
// exact search over a corpus that fits in memory wants.
//
// This is the exact answer, at a cost linear in the corpus.  hnsw-nv is
// the approximate one.
pub fn search(m: EmbMetric, query: NdFloat, corpus: NdFloat, k: Int) -> Result<[EmbHit], EmbFault>
    top_k(score_many(m, query, corpus)!, k)

// The scores of a result list, in order.
pub fn hit_scores(hits: [EmbHit]) -> [Float]
    hits |> list.map(h => h.score)

// The row positions of a result list, in order.
//
// What a caller joins back to its own identifiers.
pub fn hit_indices(hits: [EmbHit]) -> [Int]
    hits |> list.map(h => h.index)

// A cosine similarity turned into the cosine distance hnsw-nv compares
// by: `1 - s`.
//
// The one line between this package's convention and that one.  The
// reverse is the same arithmetic, which is why there is one function.
pub fn as_distance(similarity: Float) -> Float
    1.0 - similarity

// `Ok` when two vectors have one length and every coordinate is finite.
fn check_pair(a: [Float], b: [Float]) -> Result<Unit, EmbFault>
    if list.len(a) != list.len(b)
        return Err(EmbDimMismatch(list.len(a), list.len(b)))
    embrows.finite(a)!
    embrows.finite(b)

fn check_width(q: [Float], corpus: NdFloat) -> Result<Unit, EmbFault>
    if list.len(q) != embrows.cols_of(corpus)
        return Err(EmbDimMismatch(list.len(q), embrows.cols_of(corpus)))
    Ok(())

// The score of two lists of one length, both finite.
fn score_lists(m: EmbMetric, a: [Float], b: [Float]) -> Result<Float, EmbFault>
    match m
        EmbDot       => Ok(embrows.dot_of(a, b))
        EmbEuclidean => Ok(0.0 - math.sqrt(squared(a, b)))
        EmbCosine    =>
            let na = embrows.norm_of(a)
            let nb = embrows.norm_of(b)
            if na == 0.0 or nb == 0.0
                return Err(EmbZeroVector)
            Ok(embrows.dot_of(a, b) / (na * nb))

fn squared(a: [Float], b: [Float]) -> Float
    var s = 0.0
    for i in 0..list.len(a)
        let d = a[i] - b[i]
        s = s + d * d
    s
