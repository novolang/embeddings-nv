// embsim.nv — how close two embeddings are, and which of many is
// closest.
//
// Every body here is a `todo()`; the signatures are the design.
//
// EVERYTHING HERE IS A SIMILARITY, AND HIGHER IS CLOSER.  That is the
// opposite of hnsw-nv's convention and the two are deliberate: an index
// compares by MINIMUM, because that is what a priority queue and a
// greedy descent want, and a ranking sorts by MAXIMUM, because that is
// what a result list is.  Mixing them is a silent reversal that shows
// up as a search returning the least relevant documents, so each
// package states its rule once and keeps it everywhere.
//
// Euclidean is the one that has to be bent to fit, and it is bent the
// way sentence-transformers bends it: `EmbEuclidean`'s SCORE is the
// NEGATED distance, so that larger is still closer and `top_k` is one
// function rather than three.  `euclidean_distance` is the positive
// number, for a caller reporting one.
//
// ON UNIT VECTORS THE THREE AGREE ON THE ORDER.  The dot product IS the
// cosine, and the Euclidean distance is `sqrt(2 - 2 * cos)`, which is
// monotonically decreasing in it — so a ranking over normalised
// embeddings is the same ranking under all three metrics, and a caller
// should use the cheapest.  On UNNORMALISED vectors they disagree, and
// which one is right is a property of how the model was trained.
// `embnorm.is_normalized` is the check; this package does not
// normalise for anyone.
//
// ONE AGAINST MANY IS A MATRIX-VECTOR PRODUCT, and that is why this
// package takes `NdFloat` rather than lists of lists: a corpus is a
// rank-2 array, a query is rank 1, and `score_many` is one call into
// ndarray-nv's `matmul` rather than a loop this package would write
// worse.

// One ranked result: which row, and how similar.
//
// `index` is a position in whatever was ranked — the row index in the
// corpus matrix, not an identifier this package invented.  A caller
// joining back to its own records keeps its own id list in the same
// order as its rows, which is the arrangement `hnsw-nv` avoids by
// taking labels; the difference is that this package ranks a matrix it
// was handed once and an index holds one for a long time.
//
// ```novo
// use embsim
//
// fn main() [io]
//     let h = EmbHit { index: 3, score: 0.87 }
//     println("row ${h.index} at ${h.score}")
// ```
pub struct EmbHit
    // The row's position in the matrix that was ranked.
    index: Int
    // How similar, under the metric that was asked for.  Higher is
    // closer, always — see the module comment.
    score: Float

// Which similarity to rank by.
//
// ```novo
// use embsim
//
// fn main() [io]
//     println(embsim.metric_name(EmbCosine))
//     // : cosine
// ```
pub enum EmbMetric
    // `dot(a, b) / (|a| * |b|)`, in [-1, 1].  The default, and what a
    // model card means when it says "use cosine similarity".
    EmbCosine
    // `dot(a, b)`, unbounded.  The same ranking as cosine on unit
    // vectors and cheaper; on unnormalised ones it rewards magnitude,
    // which some rerankers train for on purpose.
    EmbDot
    // The NEGATED Euclidean distance, so that higher is still closer.
    // sentence-transformers does exactly this, for exactly this
    // reason.  `euclidean_distance` is the positive number.
    EmbEuclidean

// The metric's name, lower case: "cosine", "dot", "euclidean".
//
// The three spellings sentence-transformers' `SimilarityFunction`
// uses, so a caller porting a configuration does not have to translate.
pub fn metric_name(m: EmbMetric) -> Str
    todo("embeddings-nv.embsim.metric_name")

// The metric a name spells.
pub fn metric_of_name(name: Str) -> ?EmbMetric
    todo("embeddings-nv.embsim.metric_of_name")

// How similar two vectors are, under this metric.
//
// `EmbDimMismatch` when the lengths differ, `EmbZeroVector` for a zero
// vector under cosine, and `EmbNotFinite` at the first coordinate that
// is not a number.
//
// ```novo
// use embsim
// use ndfloat
//
// fn main() [io]
//     match ndfloat.of_list([1.0, 0.0], [2])
//         Err(e) => println(e.message())
//         Ok(a)  =>
//             match embsim.score(EmbDot, a, a)
//                 Ok(s)  => println("${s}")
//                           // : 1
//                 Err(f) => println(f.message())
// ```
pub fn score(m: EmbMetric, left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    todo("embeddings-nv.embsim.score")

// Cosine similarity, in [-1, 1].
//
// 1 is identical in direction, 0 is orthogonal, -1 is opposite.
// `EmbZeroVector` on either side, because the denominator is zero and
// every alternative answer is wrong in a way that hides itself.
pub fn cosine(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    todo("embeddings-nv.embsim.cosine")

// The dot product.
pub fn dot(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    todo("embeddings-nv.embsim.dot")

// Euclidean distance: `sqrt(sum((a - b)^2))`.
//
// The POSITIVE number, for reporting.  `EmbEuclidean`'s score is this
// negated, so that higher is closer everywhere in this module.
pub fn euclidean_distance(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    todo("embeddings-nv.embsim.euclidean_distance")

// Squared Euclidean distance.
//
// Monotonic in the distance, so it ranks identically and skips a
// square root per comparison.  What `score_many` computes for
// `EmbEuclidean` before it negates and, for a caller writing its own
// loop, the one to write.
pub fn euclidean_squared(left: NdFloat, right: NdFloat) -> Result<Float, EmbFault>
    todo("embeddings-nv.embsim.euclidean_squared")

// One query against every row of a corpus.
//
// `corpus` is rank 2, `[rows, dim]` — what `embpool.pool_batch` and
// `embnorm.normalize_rows` produce.  `query` is rank 1, `[dim]`.  The
// result has one score per row, in row order.
//
// A matrix-vector product, which is why this package speaks `NdFloat`:
// the loop is ndarray-nv's and it is one call rather than something
// written here.
pub fn score_many(m: EmbMetric, query: NdFloat, corpus: NdFloat) -> Result<[Float], EmbFault>
    todo("embeddings-nv.embsim.score_many")

// Every query against every row: a `[queries, rows]` matrix of scores.
//
// The batch form, and the one whose cost a caller should think about
// before reaching for it: a thousand queries against a million rows is
// a billion scores and eight gigabytes of result.  `search` is what to
// use past the point where the scores themselves stop fitting, and
// hnsw-nv is what to use past the point where the corpus does.
pub fn pairwise(m: EmbMetric, queries: NdFloat, corpus: NdFloat) -> Result<NdFloat, EmbFault>
    todo("embeddings-nv.embsim.pairwise")

// The `k` highest scores, with their positions, highest first.
//
// `EmbBadK` for a `k` below 1 or above the number of scores.  Ties
// keep their row order, so a corpus with duplicate rows ranks them the
// way it stored them — arbitrary is fine, unstable is not, because a
// result list that reorders between identical runs is one nobody can
// test.
pub fn top_k(scores: [Float], k: Int) -> Result<[EmbHit], EmbFault>
    todo("embeddings-nv.embsim.top_k")

// The `k` rows of a corpus most similar to a query.
//
// `score_many` and `top_k` in one call, which is what a caller doing
// exact search over a corpus that fits in memory wants.
//
// This is the exact answer, at a cost linear in the corpus.  hnsw-nv is
// the approximate one, at a cost logarithmic in it — and the crossover
// is lower than it looks: a hundred thousand 768-vectors is three
// hundred megabytes of arithmetic per query.
pub fn search(m: EmbMetric, query: NdFloat, corpus: NdFloat, k: Int) -> Result<[EmbHit], EmbFault>
    todo("embeddings-nv.embsim.search")

// The scores of a result list, in order.
pub fn hit_scores(hits: [EmbHit]) -> [Float]
    todo("embeddings-nv.embsim.hit_scores")

// The row positions of a result list, in order.
//
// What a caller joins back to its own identifiers.
pub fn hit_indices(hits: [EmbHit]) -> [Int]
    todo("embeddings-nv.embsim.hit_indices")

// A cosine similarity turned into the cosine DISTANCE hnsw-nv compares
// by: `1 - s`.
//
// The one line between this package's convention and that one, named
// so that neither has to know about the other and a caller moving
// between them has something to point at.  The reverse is the same
// arithmetic, which is why there is one function.
pub fn as_distance(similarity: Float) -> Float
    todo("embeddings-nv.embsim.as_distance")
